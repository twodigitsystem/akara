{
    "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "**",
            "!node_modules",
            "!.next",
            "!dist",
            "!build",
            "!design"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "auto"
    },
    "javascript": {
        "formatter": {
            "semicolons": "asNeeded"
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        },
        "domains": {
            "next": "recommended",
            "react": "recommended"
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["src/components/ui/**"],
            "linter": {
                "rules": {
                    "a11y": {
                        "useSemanticElements": "off",
                        "useKeyWithClickEvents": "off",
                        "useFocusableInteractive": "off",
                        "noLabelWithoutControl": "off",
                        "noRedundantRoles": "off"
                    },
                    "suspicious": {
                        "noArrayIndexKey": "off",
                        "noDocumentCookie": "off",
                        "noDoubleEquals": "off"
                    },
                    "security": {
                        "noDangerouslySetInnerHtml": "off"
                    },
                    "correctness": {
                        "useExhaustiveDependencies": "off"
                    }
                }
            }
        }
    ]
}
